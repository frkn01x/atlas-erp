# Atlas: uygulama kullanicisi yalnizca bu veritabanina readWrite yetkili olmali.
# Atlas Network Access listesine Docker sunucusunun dis IP adresini ekleyin.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=atlas_erp
COLLECTION_PREFIX=atlas_erp_
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
COMPANY_NAME=Sirketim
APP_PORT=8080
# HTTPS ters vekil arkasinda true yapin.
COOKIE_SECURE=false
