map $uri $erp_area {
  ~^/api/auth/ auth;
  ~^/api/ai/ ai;
  ~^/api/public/ public;
  ~^/api/ api;
  default frontend;
}
limit_req_zone $binary_remote_addr zone=erp_rate:10m rate=15r/s;
upstream erp_web {
  zone erp_web 64k;
  resolver 127.0.0.11 valid=5s ipv6=off;
  resolver_timeout 2s;
  server web:80 resolve;
}
server {
  listen 8080 default_server;
  server_name _;
  server_tokens off;
  client_max_body_size 2m;
  client_body_timeout 15s;
  add_header X-WAF "ModSecurity-OWASP-CRS" always;
  add_header X-Request-ID $request_id always;
  location = /healthz { access_log off; modsecurity off; return 200 "ok"; }
  location / {
    limit_req zone=erp_rate burst=60 nodelay;
    limit_req_status 429;
    proxy_pass http://erp_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Connection "";
    proxy_read_timeout 65s;
    proxy_connect_timeout 10s;
    modsecurity_transaction_id $request_id;
  }
}
server {
  listen 8081;
  server_name _;
  access_log off;
  modsecurity off;
  location = /stub_status { stub_status; }
  location / { return 404; }
}
