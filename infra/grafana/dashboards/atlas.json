{
  "id": null,
  "uid": "atlas-security-ops",
  "title": "Atlas ERP — Guvenlik ve Operasyon",
  "tags": [
    "atlas",
    "security",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API metrics erisimi",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"atlas-api\"})",
          "queryType": "range",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
